@model IEnumerable<p6.Models.Product>

@{
    ViewData["Title"] = "Product Catalog";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Product Catalog</h2>
    
    <!-- Category Filter Form -->
    <form method="get" asp-action="Index" class="d-flex gap-2">
        <select name="searchCategory" class="form-select" onchange="this.form.submit()">
            <option value="">All Categories</option>
            @if (ViewBag.Categories != null)
            {
                foreach (var cat in ViewBag.Categories)
                {
                    <option value="@cat">@cat</option>
                }
            }
        </select>
    </form>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <span class="badge bg-secondary mb-2">@item.Category</span>
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text text-muted">@item.Description</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0 text-success">$@item.Price.ToString("F2")</span>
                        <span class="badge @(item.IsInStock ? "bg-success" : "bg-danger")">
                            @(item.IsInStock ? "In Stock" : "Out of Stock")
                        </span>
                    </div>
                </div>
                <div class="card-footer bg-white border-top-0 text-end">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">View Details</a>
                </div>
            </div>
        </div>
    }
</div>