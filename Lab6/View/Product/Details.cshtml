@model p6.Models.Product

@{
    ViewData["Title"] = Model.Name + " - Details";
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary mb-3">&larr; Back to Catalog</a>

    <div class="card shadow">
        <div class="row g-0">
            <div class="col-md-5">
                <img src="@Model.ImageUrl" class="img-fluid rounded-start h-100 w-100" style="object-fit: cover;" alt="@Model.Name">
            </div>
            <div class="col-md-7">
                <div class="card-body p-4">
                    <span class="badge bg-primary mb-2">@Model.Category</span>
                    <h2 class="card-title">@Model.Name</h2>
                    <h3 class="text-success my-3">$@Model.Price.ToString("F2")</h3>

                    <p class="card-text text-secondary mb-4">@Model.Description</p>

                    <p class="card-text">
                        <strong>Availability: </strong>
                        <span class="badge @(Model.IsInStock ? "bg-success" : "bg-danger")">
                            @(Model.IsInStock ? "In Stock" : "Out of Stock")
                        </span>
                    </p>

                    <div class="mt-4">
                        <button class="btn btn-primary btn-lg" @(Model.IsInStock ? "" : "disabled")>
                            Buy Now
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
